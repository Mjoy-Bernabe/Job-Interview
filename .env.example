# Local MySQL Server connection used by MySQL Workbench
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=auth_db

# Flask settings
SECRET_KEY=replace-this-with-a-long-random-secret
PORT=5000

# Optional email settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
