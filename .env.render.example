# Aiven MySQL credentials copied from Aiven > Overview > Connection information
MYSQL_HOST=your-service-name.aivencloud.com
MYSQL_PORT=10859
MYSQL_USER=avnadmin
MYSQL_PASSWORD=replace-with-your-current-aiven-password
MYSQL_DB=auth_db

# Aiven requires an encrypted connection.
MYSQL_SSL_MODE=REQUIRED
MYSQL_CONNECT_TIMEOUT=20

# Optional stronger certificate validation:
# 1. Download ca.pem from Aiven.
# 2. Put it in the project, for example database/ca.pem.
# 3. Uncomment this variable.
# MYSQL_SSL_CA=database/ca.pem

SECRET_KEY=replace-with-a-long-random-secret
MAX_RESUME_SIZE=10485760
