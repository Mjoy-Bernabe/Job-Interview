# Recommended for Render + Railway MySQL:
# Copy Railway's fully resolved MYSQL_PUBLIC_URL value here.
MYSQL_PUBLIC_URL=mysql://root:YOUR_PASSWORD@YOUR_PUBLIC_PROXY_HOST:YOUR_PUBLIC_PROXY_PORT/railway

# Alternative: enter the values separately instead of MYSQL_PUBLIC_URL.
# MYSQL_HOST=YOUR_PUBLIC_PROXY_HOST
# MYSQL_PORT=YOUR_PUBLIC_PROXY_PORT
# MYSQL_USER=root
# MYSQL_PASSWORD=YOUR_PASSWORD
# MYSQL_DB=railway

SECRET_KEY=replace-with-a-long-random-secret
MAX_RESUME_SIZE=10485760
